server:
  host: "0.0.0.0" # 服务端主机
  port: 40000 # 服务端端口
  
  name: "OneGoServer" # 服务端名称
  mode: "debug" # 服务端模式 debug 开发模式 release 生产模式
  version: "1.0.0" # 服务端版本
  description: "OneGoServer is a server for the OneGo client" # 服务端描述
  author: "YoungBoyGod" # 服务端作者
  email: "youngboygod@gmail.com" # 服务端邮箱
  url: "https://github.com/YoungBoyGod/OneGoServer" # 服务端地址
  copyright: "Copyright 2025 YoungBoyGod" # 服务端版权信息
  
# 数据库配置
database:
  type: "postgres" # 数据库类型: sqlite, mysql, postgres
  host: "${DB_HOST}" # 环境变量：数据库主机
  port: ${DB_PORT} # 环境变量：数据库端口
  username: "${DB_USERNAME}" # 环境变量：数据库用户名
  password: "${DB_PASSWORD}" # 环境变量：数据库密码
  dbname: "${DB_NAME}" # 环境变量：数据库名称
  charset: "utf8mb4"
  parse_time: true
  loc: "Local"
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 3600

# 日志配置
logging:
  level: "debug" # 日志级别: debug, info, warn, error
  format: "json" # 日志格式: json, text
  output: "both" # 输出方式: stdout, file, both
  
  file_path: "logs/app_{timestamp}.log" # 日志文件路径，{timestamp}将被替换为当前时间
  max_size: 100 # 单个日志文件最大大小(MB)
  max_backups: 3 # 保留的日志文件数量
  max_age: 30 # 日志文件保留天数
  compress: true # 是否压缩日志文件

# JWT配置
jwt:
  secret: "${JWT_SECRET}" # 环境变量：JWT密钥
  expire_hours: 24 # Token过期时间(小时)
  issuer: "OneGoServer"

# 安全配置
security:
  cors:
    allow_origins: ["*"]
    allow_methods: ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
    allow_headers: ["Origin", "Content-Type", "Authorization"]
    expose_headers: ["Content-Length"]
    max_age: 12 # 预检请求缓存时间(小时)
  
  rate_limit:
    enabled: true
    requests_per_minute: 100
    burst: 50

# 业务配置
business:
  user:
    password_min_length: 6
    username_min_length: 3
    max_login_attempts: 5
    account_lockout_duration: 300 # 秒 